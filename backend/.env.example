# Sao chép thành .env nếu cần (đã nằm trong .gitignore). Không commit mật khẩu thật.
# Backend đọc biến môi trường của tiến trình; nạp file .env bằng công cụ bạn dùng (hoặc set thủ công).

# Nguồn giá khi repository=memory: demo | vnstock
STOCKWATCH_PROVIDER=demo

# Nơi API đọc dữ liệu: memory (lấy từ provider vào bộ nhớ, không lưu) | db (đọc DATABASE_URL)
STOCKWATCH_REPOSITORY=memory

# Danh sách mã theo dõi (mặc định config/watchlist.toml)
# STOCKWATCH_WATCHLIST=config/watchlist.toml

# Nguồn được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy
# STOCKWATCH_CORS_ORIGINS=http://localhost:5173

# Chỉ dùng khi repository=db hoặc lệnh `stockwatch fetch`:
# PostgreSQL chạy bằng docker compose ở thư mục gốc:
# DATABASE_URL=postgresql://stockwatch:stockwatch@localhost:5432/stockwatch
# Supabase: dùng chuỗi kết nối trong Project Settings > Database
# SQLite (mặc định):
# DATABASE_URL=sqlite:///data/stock.db
