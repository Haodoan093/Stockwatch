# Sao chép thành .env.local nếu cần đổi mặc định.

# Địa chỉ API mà trình duyệt gọi. Để trống = cùng origin (dev dùng proxy của Vite, nên để trống).
# Khi deploy frontend tách khỏi backend, đặt ví dụ: https://api.example.com
VITE_API_BASE_URL=

# Chỉ dùng khi chạy `npm run dev`: backend mà proxy /api chuyển tới.
VITE_PROXY_TARGET=http://127.0.0.1:8000
